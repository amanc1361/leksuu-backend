# Production payments: copy these into the PRODUCTION .env on the VPS.
# (Other production settings — JWT_SECRET, ADMIN_*, MEDIA_*, S3_* — as before.)
COVER_IMAGE_API_KEY=
COVER_IMAGE_MODEL=gpt-image-2.5-flare
# Optional build mirror for pinned media worker wheels; official PyPI is the default.
PIP_INDEX_URL=

# ZarinPal live gateway. The merchant id is the 36-character code from your
# ZarinPal panel; the site domain must match the one registered there.
PAYMENT_PROVIDER=zarinpal
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID=

# Public https addresses of the site (it proxies /api/v1 to the API). The API
# refuses to start with a localhost or non-https address here.
BILLING_CALLBACK_URL=https://leksuu.ir/api/v1/billing/callback
BILLING_SUCCESS_URL=https://leksuu.ir/fa/billing/success
BILLING_FAIL_URL=https://leksuu.ir/fa/billing/fail

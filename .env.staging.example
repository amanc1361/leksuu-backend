# Staging: copy to .env inside the STAGING clone on the VPS (not the production
# folder) and fill in the blanks. Everything here keeps staging apart from
# production: its own Compose project, containers, volumes and ports.

# Separate project + ports (production uses leksuu-backend / 8080 / 5432 / 6379).
COMPOSE_PROJECT_NAME=leksuu-staging
API_PORT=8081
DB_PORT=5433
REDIS_PORT=6380

# Use a DIFFERENT secret from production, so staging logins never work there.
JWT_SECRET=
ADMIN_EMAILS=admin@leksuu.app
ADMIN_PASSWORD=
COVER_IMAGE_API_KEY=
COVER_IMAGE_MODEL=gpt-image-2.5-flare

# Payments on staging go to ZarinPal's SANDBOX: the whole flow runs, no money
# moves. (The API runs as production, which turns the old "stub" off.)
# The sandbox accepts any UUID-shaped merchant id.
PAYMENT_PROVIDER=zarinpal
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# Public addresses of the STAGING site (the site proxies /api/v1 to the API).
BILLING_CALLBACK_URL=https://staging.leksuu.ir/api/v1/billing/callback
BILLING_SUCCESS_URL=https://staging.leksuu.ir/fa/billing/success
BILLING_FAIL_URL=https://staging.leksuu.ir/fa/billing/fail

# Public base of stored media URLs: the staging site/API address.
MEDIA_PUBLIC_URL=

# Same as production if your builds need it (Go module proxy).
GOPROXY=
# Optional build mirror for pinned Python worker wheels. Verify wheel hashes
# against PyPI before using a third-party mirror; official PyPI is the default.
PIP_INDEX_URL=

# If staging shares production's S3 bucket, give it its own prefix so the two
# never overwrite each other's files.
S3_ENDPOINT=
S3_BUCKET=
S3_PREFIX=staging/
S3_ACCESS_KEY=
S3_SECRET_KEY=
